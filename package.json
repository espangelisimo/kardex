{
  "name": "kardex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:db": "supabase test db",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run test:hooks && npm run check:secrets && npm run build",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "test:hooks": "node scripts/test-guard.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.109.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "supabase": "^3.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "26.x"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23"
    }
  }
}
